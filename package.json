{
  "name": "star-key",
  "private": true,
  "version": "0.1.2",
  "description": "Star Key: experimental VTA browser extension and local City Key reader, based on OpenVTC.",
  "type": "module",
  "workspaces": [
    "packages/tsp-js",
    "packages/core",
    "packages/pwa",
    "packages/extension",
    "packages/demo-rp",
    "packages/reviewer-demo"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:pwa": "npm run dev --workspace @openvtc/pnm-pwa",
    "dev:extension": "npm run dev --workspace @openvtc/pnm-extension",
    "dev:demo-rp": "npm run start --workspace @openvtc/pnm-demo-rp",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:star-preview": "npm exec --workspace @openvtc/pnm-extension -- vite build --config vite.config.star-preview.ts --mode web-experiment && node scripts/copy-star-art.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "esbuild": "^0.28.1",
    "@swc/core": "~1.15.47",
    "@swc/wasm": "~1.15.47"
  },
  "dependencies": {
    "@openvtc/trust-tasks": "^0.17.1"
  }
}
